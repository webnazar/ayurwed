generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String?
  role              Role               @default(CONSUMER)
  avatar            String?
  phone             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  appointments      Appointment[]
  consultantProfile ConsultantProfile?
  consumerProfile   ConsumerProfile?
  enquiries         Enquiry[]
  enrollments       Enrollment[]
  articles          KnowledgeArticle[]
  orders            Order[]
  prescriptions     Prescription[]     @relation("PatientPrescriptions")
  reviews           Review[]
  notifications     Notification[]
  fulfillments      Fulfillment[]      @relation("PatientFulfillments")
  sessions          Session[]
  shopOrders        ShopOrder[]
  shopReviews       ShopReview[]

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model ConsultantProfile {
  id                 Int            @id @default(autoincrement())
  userId             Int            @unique
  specialization     String
  experience         Int
  bio                String         @db.Text
  languages          String         @db.LongText
  consultationFee    Decimal        @db.Decimal(10, 2)
  followUpFee        Decimal        @default(150.00) @db.Decimal(10, 2)
  isVerified         Boolean        @default(false)
  verifiedAt         DateTime?
  registrationCouncil String?       @db.VarChar(255)
  verificationProofUrl String?      @db.Text
  rating             Decimal        @default(0.00) @db.Decimal(3, 2)
  totalReviews       Int            @default(0)
  availability       String         @db.LongText
  degree             String?
  registrationNumber String?        @db.VarChar(100)
  isCaiCertified     Boolean        @default(false)
  isAcfp             Boolean        @default(false)
  acfpVerifiedAt     DateTime?
  fulfillmentMethod  String         @default("COURIER")
  hasOnline          Boolean        @default(true)
  hasOffline         Boolean        @default(false)
  hasFulfillment     Boolean        @default(false)
  hasHomeDelivery    Boolean        @default(false)
  hasClinicPickup    Boolean        @default(false)
  hasSelfDispatch    Boolean        @default(false)
  hasAyurwedDelivery Boolean        @default(false)
  procurementDeclaration Boolean   @default(false)
  procurementReference   String?   @db.VarChar(255)
  appointments       Appointment[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions      Prescription[]
  fulfillments       Fulfillment[]  @relation("ConsultantFulfillments")
  customMedicines    CustomMedicine[]

  @@map("consultant_profiles")
}

model ConsumerProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  address        String?   @db.Text
  city           String?
  state          String?
  pincode        String?
  dateOfBirth    DateTime?
  gender         String?
  medicalHistory String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  weight         Decimal?  @db.Decimal(5, 2)
  height         Decimal?  @db.Decimal(5, 2)
  bodyTemperature Decimal? @db.Decimal(4, 1)
  bloodPressure  String?
  prakruti       String?
  activityLevel  String?
  landmark       String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consumer_profiles")
}

model Protocol {
  id           Int        @id @default(autoincrement())
  name         String
  slug         String     @unique
  description  String     @db.Text
  indicationId Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  indication   Indication @relation(fields: [indicationId], references: [id])
  products     Product[]  @relation("ProductToProtocol")

  @@index([indicationId], map: "protocols_indicationId_fkey")
  @@map("protocols")
}

model Indication {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  slug             String         @unique
  description      String?        @db.Text
  symptomsKeywords String?        @db.Text
  isActive         Boolean        @default(true)
  protocols        Protocol[]
  products         Product[]      @relation("IndicationToProduct")
  prescriptions    Prescription[] @relation("IndicationToPrescription")
  symptoms         Symptom[]      @relation("SymptomToIndication")

  @@map("indications")
}

model Symptom {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  description String?      @db.Text
  isActive    Boolean      @default(true)
  indications Indication[] @relation("SymptomToIndication")
  products    Product[]    @relation("SymptomToProduct")

  @@map("symptoms")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId], map: "reviews_productId_fkey")
  @@index([userId], map: "reviews_userId_fkey")
  @@map("reviews")
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId], map: "enquiries_productId_fkey")
  @@index([userId], map: "enquiries_userId_fkey")
  @@map("enquiries")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  consultantId    Int
  userId          Int
  scheduledAt     DateTime
  duration        Int               @default(30)
  status          AppointmentStatus @default(PENDING)
  type            ConsultationType
  concern         String            @db.Text
  notes           String?           @db.Text
  fee             Decimal           @db.Decimal(10, 2)
  paymentId       String?
  meetingLink     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  patientAge      Int?
  patientGender   String?
  patientHeight   Decimal?          @db.Decimal(5, 2)
  patientWeight   Decimal?          @db.Decimal(5, 2)
  patientBodyTemperature Decimal?   @db.Decimal(4, 1)
  patientBloodPressure  String?
  patientPrakruti       String?
  patientActivityLevel  String?
  patientName     String?
  patientRelation String?
  allergies       String?
  chronicDiseases String?
  patientPhone    String?
  consultant      ConsultantProfile @relation(fields: [consultantId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  prescription    Prescription?

  @@index([consultantId], map: "appointments_consultantId_fkey")
  @@index([userId], map: "appointments_userId_fkey")
  @@map("appointments")
}

model KnowledgeArticle {
  id            Int         @id @default(autoincrement())
  title         String
  slug          String      @unique
  excerpt       String
  content       String      @db.LongText
  type          ArticleType
  tags          String      @db.LongText
  featuredImage String?
  authorId      Int
  isPublished   Boolean     @default(false)
  isSponsored   Boolean     @default(false)
  sponsorName   String?
  sponsorUrl    String?
  publishedAt   DateTime?
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  author        User        @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([type])
  @@index([authorId], map: "knowledge_articles_authorId_fkey")
  @@map("knowledge_articles")
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String
  slug         String       @unique
  description  String       @db.Text
  price        Decimal      @db.Decimal(10, 2)
  discountPrice Decimal?    @db.Decimal(10, 2)
  couponCode   String?
  couponDiscountPrice Decimal? @db.Decimal(10, 2)
  instructorId Int
  thumbnail    String
  isPublished  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  lessons      Lesson[]

  @@map("courses")
}

model Lesson {
  id       Int     @id @default(autoincrement())
  courseId Int
  title    String
  content  String  @db.LongText
  videoUrl String?
  order    Int
  duration Int
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "lessons_courseId_fkey")
  @@map("lessons")
}

model Enrollment {
  id             Int       @id @default(autoincrement())
  userId         Int
  courseId       Int
  progress       Int       @default(0)
  completedAt    DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())
  course         Course    @relation(fields: [courseId], references: [id])
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId], map: "enrollments_courseId_fkey")
  @@map("enrollments")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  subtitle  String
  quote     String   @db.Text
  rating    Int      @default(5)
  avatar    String?
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Carousel {
  id        Int      @id @default(autoincrement())
  title     String
  image     String   @db.LongText
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("carousels")
}

model Order {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique
  userId          Int
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String        @default("COD")
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingAddress String?       @db.LongText
  billingAddress  String?       @db.LongText
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId], map: "orders_userId_fkey")
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId], map: "order_items_productId_fkey")
  @@index([orderId], map: "order_items_orderId_fkey")
  @@map("order_items")
}

model Prescription {
  id                 Int                @id @default(autoincrement())
  patientId          Int
  consultantId       Int
  appointmentId      Int?               @unique
  patientAge         Int?
  patientGender      String?
  patientHeight      Decimal?           @db.Decimal(5, 2)
  patientWeight      Decimal?           @db.Decimal(5, 2)
  patientBodyTemperature Decimal?        @db.Decimal(4, 1)
  patientBloodPressure  String?
  patientPrakruti       String?
  patientActivityLevel  String?
  chronicConditions  String?            @db.Text
  consultantJudgment String             @db.Text
  dosageInstructions String?            @db.Text
  followUpAdvice     String?            @db.VarChar(100)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  status             PrescriptionStatus @default(DRAFT)
  items              PrescriptionItem[]
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id])
  consultant         ConsultantProfile  @relation(fields: [consultantId], references: [id])
  patient            User               @relation("PatientPrescriptions", fields: [patientId], references: [id])
  indications        Indication[]       @relation("IndicationToPrescription")
  fulfillment        Fulfillment?

  @@index([consultantId], map: "prescriptions_consultantId_fkey")
  @@index([patientId], map: "prescriptions_patientId_fkey")
  @@map("prescriptions")
}

model PrescriptionItem {
  id               Int             @id @default(autoincrement())
  prescriptionId   Int
  productId        Int?
  customMedicineId Int?
  customName       String?
  dosage           String
  frequency        String
  duration         String
  instructions     String?         @db.Text
  product          Product?        @relation(fields: [productId], references: [id])
  customMedicine   CustomMedicine? @relation(fields: [customMedicineId], references: [id])
  prescription     Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([productId], map: "prescription_items_productId_fkey")
  @@index([customMedicineId])
  @@map("prescription_items")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

enum Role {
  CONSUMER
  CONSULTANT
  ADMIN
}

enum ArticleType {
  HERB
  CONDITION
  DIET
  LIFESTYLE
  RESEARCH
}

enum PreparationType {
  LIQUID_EXTRACT
  POWDER
  CAPSULE
  TABLET
  OIL
  CREAM
  READY_PRODUCT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  PRESCRIBED
  FULFILLED
  COMPLETED
}

enum ConsultationType {
  CHAT
  AUDIO
  VIDEO
  OFFLINE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Fulfillment {
  id             Int      @id @default(autoincrement())
  prescriptionId Int      @unique
  consultantId   Int
  patientId      Int
  method         String   @default("COURIER") // "COURIER" or "PICKUP"
  status         String   @default("PENDING") // "PENDING", "CONFIRMED", "PACKED", "DISPATCHED", "READY_FOR_PICKUP", "COMPLETED", "CANCELLED"
  trackingNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription      @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  consultant   ConsultantProfile @relation("ConsultantFulfillments", fields: [consultantId], references: [id], onDelete: Cascade)
  patient      User              @relation("PatientFulfillments", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([consultantId])
  @@index([patientId])
  @@map("fulfillments")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ==========================================
// eCommerce / Shop Models
// ==========================================

model Manufacturer {
  id                   Int       @id @default(autoincrement())
  companyName          String
  slug                 String    @unique
  slogan               String?
  description          String    @db.Text
  logo                 String?
  manufacturingLicense String?
  certifications       String?   @db.LongText
  gstNumber            String?
  website              String?
  contactEmail         String?
  contactPhone         String?
  isVerified           Boolean   @default(false)
  isFeatured           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  products             Product[]

  @@map("manufacturers")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  image       String?
  icon        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  slug           String         @unique
  description    String         @db.Text
  shortDesc      String?        @db.VarChar(500)
  botanicalName   String?
  type           PreparationType? @default(READY_PRODUCT)
  volume         Int?
  volumeUnit     String?
  weight         Int?
  weightUnit     String?
  count          Int?
  countUnit      String?
  ingredients    String?        @db.LongText
  benefits       String?        @db.LongText
  usage          String?        @db.Text
  category       String?
  categoryId     Int?
  manufacturerId Int?
  sku            String?        @unique
  barcode        String?
  mrp            Decimal        @db.Decimal(10, 2)
  sellingPrice   Decimal        @db.Decimal(10, 2)
  stock          Int            @default(0)
  unit           String?
  images         String?        @db.LongText
  tags           String?        @db.LongText
  targetAudience String         @default("BOTH")
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  isSponsored    Boolean        @default(false)
  rating         Decimal        @default(0.00) @db.Decimal(3, 2)
  totalReviews   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  categoryRef    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  shopOrderItems ShopOrderItem[]
  shopReviews    ShopReview[]
  prescriptionItems PrescriptionItem[]
  indications    Indication[]   @relation("IndicationToProduct")
  symptoms       Symptom[]      @relation("SymptomToProduct")
  protocols      Protocol[]     @relation("ProductToProtocol")
  orderItems     OrderItem[]
  reviews        Review[]
  enquiries      Enquiry[]

  @@index([slug])
  @@index([manufacturerId])
  @@index([categoryId])
  @@map("products")
}

model ShopCoupon {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  discountType      String   @default("PERCENTAGE") // PERCENTAGE or FLAT
  discountValue     Decimal  @db.Decimal(10, 2)
  minOrderAmount    Decimal? @db.Decimal(10, 2)
  maxDiscountAmount Decimal? @db.Decimal(10, 2)
  isPublished       Boolean  @default(true)
  usageCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("shop_coupons")
}

model ShopOrder {
  id              Int             @id @default(autoincrement())
  orderNumber     String          @unique
  userId          Int
  status          ShopOrderStatus @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentMethod   String          @default("COD")
  subtotal        Decimal         @db.Decimal(10, 2)
  discount        Decimal?        @default(0) @db.Decimal(10, 2)
  couponCode      String?
  shipping        Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  shippingAddress String?         @db.LongText
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           ShopOrderItem[]
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("shop_orders")
}

model ShopOrderItem {
  id        Int       @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal   @db.Decimal(10, 2)
  total     Decimal   @db.Decimal(10, 2)
  product   Product   @relation(fields: [productId], references: [id])
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("shop_order_items")
}

model ShopReview {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("shop_reviews")
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model CustomMedicine {
  id                Int                @id @default(autoincrement())
  name              String
  type              String?            @default("CUSTOM")
  description       String?            @db.Text
  composition       String?            @db.Text
  manufacturer      String?
  price             Decimal?           @db.Decimal(10, 2)
  dosage            String?
  instructions      String?            @db.Text
  consultantId      Int?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  consultant        ConsultantProfile? @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  prescriptionItems PrescriptionItem[]

  @@index([consultantId])
  @@map("custom_medicines")
}
