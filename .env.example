# Database Connection (Hostinger MySQL)
# Format: mysql://<username>:<password>@<host>:3306/<database_name>?connection_limit=10
DATABASE_URL="mysql://u123456789_ayurwed:YourStrongPassword@localhost:3306/u123456789_ayurwed?connection_limit=10"

# NextAuth Configuration
# Replace NEXTAUTH_URL with your production domain (e.g. https://ayurwed.com)
NEXTAUTH_URL="https://ayurwed.com"
# Generate a strong 32+ character random string for production
NEXTAUTH_SECRET="replace-with-a-very-strong-production-secret-key-32-chars-min"

# Google Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay (Payments & Enrollments)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Google Calendar / Meet (Optional)
GOOGLE_REFRESH_TOKEN=""
