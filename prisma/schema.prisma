generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String?
  role              Role               @default(CONSUMER)
  avatar            String?
  phone             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  appointments      Appointment[]
  consultantProfile ConsultantProfile?
  consumerProfile   ConsumerProfile?
  enquiries         Enquiry[]
  enrollments       Enrollment[]
  articles          KnowledgeArticle[]
  orders            Order[]
  prescriptions     Prescription[]     @relation("PatientPrescriptions")
  reviews           Review[]
  notifications     Notification[]
  fulfillments      Fulfillment[]      @relation("PatientFulfillments")
  sessions          Session[]

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model ConsultantProfile {
  id                 Int            @id @default(autoincrement())
  userId             Int            @unique
  specialization     String
  experience         Int
  bio                String         @db.Text
  languages          String         @db.LongText
  consultationFee    Decimal        @db.Decimal(10, 2)
  followUpFee        Decimal        @default(150.00) @db.Decimal(10, 2)
  isVerified         Boolean        @default(false)
  rating             Decimal        @default(0.00) @db.Decimal(3, 2)
  totalReviews       Int            @default(0)
  availability       String         @db.LongText
  degree             String?
  registrationNumber String?        @db.VarChar(100)
  isCaiCertified     Boolean        @default(false)
  isAcfp             Boolean        @default(false)
  acfpVerifiedAt     DateTime?
  fulfillmentMethod  String         @default("COURIER")
  hasOnline          Boolean        @default(true)
  hasOffline         Boolean        @default(false)
  hasFulfillment     Boolean        @default(false)
  hasHomeDelivery    Boolean        @default(false)
  hasClinicPickup    Boolean        @default(false)
  hasSelfDispatch    Boolean        @default(false)
  hasAyurwedDelivery Boolean        @default(false)
  appointments       Appointment[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions      Prescription[]
  fulfillments       Fulfillment[]  @relation("ConsultantFulfillments")

  @@map("consultant_profiles")
}

model ConsumerProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  address        String?   @db.Text
  city           String?
  state          String?
  pincode        String?
  dateOfBirth    DateTime?
  gender         String?
  medicalHistory String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  weight         Decimal?  @db.Decimal(5, 2)
  landmark       String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consumer_profiles")
}

model Preparation {
  id                Int                @id @default(autoincrement())
  type              PreparationType    @default(LIQUID_EXTRACT)
  name              String
  botanicalName     String?
  volume            Int?
  volumeUnit        String?
  weight            Int?
  weightUnit        String?
  count             Int?
  countUnit         String?
  stock             Int                @default(0)
  slug              String             @unique
  description       String             @db.Text
  ingredients       String?            @db.LongText
  benefits          String             @db.LongText
  usage             String             @db.Text
  mrp               Decimal?           @db.Decimal(10, 2)
  images            String             @db.LongText
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  isSponsored       Boolean            @default(false)
  rating            Decimal            @default(0.00) @db.Decimal(3, 2)
  totalReviews      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  enquiries         Enquiry[]
  orderItems        OrderItem[]
  prescriptionItems PrescriptionItem[]
  reviews           Review[]
  indications       Indication[]       @relation("IndicationToPreparation")
  protocols         Protocol[]         @relation("PreparationToProtocol")

  @@index([slug])
  @@map("preparations")
}

model Protocol {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  description  String        @db.Text
  indicationId Int
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  indication   Indication    @relation(fields: [indicationId], references: [id])
  preparations Preparation[] @relation("PreparationToProtocol")

  @@index([indicationId], map: "protocols_indicationId_fkey")
  @@map("protocols")
}

model Indication {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  slug          String         @unique
  description   String?        @db.Text
  isActive      Boolean        @default(true)
  protocols     Protocol[]
  preparations  Preparation[]  @relation("IndicationToPreparation")
  prescriptions Prescription[] @relation("IndicationToPrescription")

  @@map("indications")
}

model Review {
  id          Int         @id @default(autoincrement())
  userId      Int
  rating      Int
  comment     String      @db.Text
  createdAt   DateTime    @default(now())
  extractId   Int
  preparation Preparation @relation(fields: [extractId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([extractId], map: "reviews_extractId_fkey")
  @@index([userId], map: "reviews_userId_fkey")
  @@map("reviews")
}

model Enquiry {
  id          Int          @id @default(autoincrement())
  userId      Int?
  name        String
  email       String
  phone       String?
  message     String       @db.Text
  isRead      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  extractId   Int?
  preparation Preparation? @relation(fields: [extractId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([extractId], map: "enquiries_extractId_fkey")
  @@index([userId], map: "enquiries_userId_fkey")
  @@map("enquiries")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  consultantId    Int
  userId          Int
  scheduledAt     DateTime
  duration        Int               @default(30)
  status          AppointmentStatus @default(PENDING)
  type            ConsultationType
  concern         String            @db.Text
  notes           String?           @db.Text
  fee             Decimal           @db.Decimal(10, 2)
  paymentId       String?
  meetingLink     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  patientAge      Int?
  patientGender   String?
  patientName     String?
  patientRelation String?
  allergies       String?
  chronicDiseases String?
  patientPhone    String?
  consultant      ConsultantProfile @relation(fields: [consultantId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  prescription    Prescription?

  @@index([consultantId], map: "appointments_consultantId_fkey")
  @@index([userId], map: "appointments_userId_fkey")
  @@map("appointments")
}

model KnowledgeArticle {
  id            Int         @id @default(autoincrement())
  title         String
  slug          String      @unique
  excerpt       String
  content       String      @db.LongText
  type          ArticleType
  tags          String      @db.LongText
  featuredImage String?
  authorId      Int
  isPublished   Boolean     @default(false)
  isSponsored   Boolean     @default(false)
  sponsorName   String?
  sponsorUrl    String?
  publishedAt   DateTime?
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  author        User        @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([type])
  @@index([authorId], map: "knowledge_articles_authorId_fkey")
  @@map("knowledge_articles")
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String
  slug         String       @unique
  description  String       @db.Text
  price        Decimal      @db.Decimal(10, 2)
  instructorId Int
  thumbnail    String
  isPublished  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  lessons      Lesson[]

  @@map("courses")
}

model Lesson {
  id       Int     @id @default(autoincrement())
  courseId Int
  title    String
  content  String  @db.LongText
  videoUrl String?
  order    Int
  duration Int
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "lessons_courseId_fkey")
  @@map("lessons")
}

model Enrollment {
  id             Int       @id @default(autoincrement())
  userId         Int
  courseId       Int
  progress       Int       @default(0)
  completedAt    DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())
  course         Course    @relation(fields: [courseId], references: [id])
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId], map: "enrollments_courseId_fkey")
  @@map("enrollments")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  subtitle  String
  quote     String   @db.Text
  rating    Int      @default(5)
  avatar    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Carousel {
  id        Int      @id @default(autoincrement())
  title     String
  image     String   @db.LongText
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("carousels")
}

model Order {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique
  userId          Int
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String        @default("COD")
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingAddress String?       @db.LongText
  billingAddress  String?       @db.LongText
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId], map: "orders_userId_fkey")
  @@map("orders")
}

model OrderItem {
  id          Int         @id @default(autoincrement())
  orderId     Int
  quantity    Int
  price       Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  extractId   Int
  preparation Preparation @relation(fields: [extractId], references: [id])
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([extractId], map: "order_items_extractId_fkey")
  @@index([orderId], map: "order_items_orderId_fkey")
  @@map("order_items")
}

model Prescription {
  id                 Int                @id @default(autoincrement())
  patientId          Int
  consultantId       Int
  appointmentId      Int?               @unique
  patientAge         Int?
  patientGender      String?
  patientWeight      Decimal?           @db.Decimal(5, 2)
  chronicConditions  String?            @db.Text
  consultantJudgment String             @db.Text
  dosageInstructions String?            @db.Text
  followUpAdvice     String?            @db.VarChar(100)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  status             PrescriptionStatus @default(DRAFT)
  items              PrescriptionItem[]
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id])
  consultant         ConsultantProfile  @relation(fields: [consultantId], references: [id])
  patient            User               @relation("PatientPrescriptions", fields: [patientId], references: [id])
  indications        Indication[]       @relation("IndicationToPrescription")
  fulfillment        Fulfillment?

  @@index([consultantId], map: "prescriptions_consultantId_fkey")
  @@index([patientId], map: "prescriptions_patientId_fkey")
  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  preparationId  Int
  dosage         String
  frequency      String
  duration       String
  instructions   String?      @db.Text
  preparation    Preparation  @relation(fields: [preparationId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([preparationId], map: "prescription_items_preparationId_fkey")
  @@index([prescriptionId], map: "prescription_items_prescriptionId_fkey")
  @@map("prescription_items")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

enum Role {
  CONSUMER
  CONSULTANT
  ADMIN
}

enum ArticleType {
  HERB
  CONDITION
  DIET
  LIFESTYLE
  RESEARCH
}

enum PreparationType {
  LIQUID_EXTRACT
  POWDER
  CAPSULE
  TABLET
  OIL
  CREAM
  READY_PRODUCT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  PRESCRIBED
  FULFILLED
  COMPLETED
}

enum ConsultationType {
  CHAT
  AUDIO
  VIDEO
  OFFLINE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Fulfillment {
  id             Int      @id @default(autoincrement())
  prescriptionId Int      @unique
  consultantId   Int
  patientId      Int
  method         String   @default("COURIER") // "COURIER" or "PICKUP"
  status         String   @default("PENDING") // "PENDING", "CONFIRMED", "PACKED", "DISPATCHED", "READY_FOR_PICKUP", "COMPLETED", "CANCELLED"
  trackingNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription      @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  consultant   ConsultantProfile @relation("ConsultantFulfillments", fields: [consultantId], references: [id], onDelete: Cascade)
  patient      User              @relation("PatientFulfillments", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([consultantId])
  @@index([patientId])
  @@map("fulfillments")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
